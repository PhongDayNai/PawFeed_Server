# Pet Feeder Server - Phase 0
NODE_ENV=development
APP_NAME=pet-feeder-server
APP_VERSION=4.1
PORT=3000
HOST=0.0.0.0

# Comma-separated origins. Use * only for local testing.
CORS_ORIGIN=*

# Request body limit
JSON_BODY_LIMIT=1mb

# Rate limit for all /api routes
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Enable a local route for testing 500 JSON error response.
# GET /api/dev/error
ENABLE_DEV_ERROR_ROUTE=false

# Docker host ports
APP_PORT=3000
MYSQL_PORT=3306

# MySQL container settings
MYSQL_DATABASE=pet_feeder
MYSQL_USER=pet_feeder
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me

# App DB connection settings. DB_HOST=db when running with docker compose.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pet_feeder
DB_USER=pet_feeder
DB_PASSWORD=change_me
