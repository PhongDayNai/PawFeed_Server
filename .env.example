# Pet Feeder Server - Phase 20
# Pet Feeder Server - Phase 17 compatibility marker
NODE_ENV=development
APP_NAME=pet-feeder-server
APP_VERSION=4.1
PORT=3000
HOST=0.0.0.0

# Comma-separated origins. Use * only for local testing.
CORS_ORIGIN=*

# Request body limit
JSON_BODY_LIMIT=1mb

# Rate limit for all /api routes
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120


# Phase 19 security hardening
# TRUST_PROXY=true when running behind nginx/Caddy/Cloudflare/Render/railway proxy.
TRUST_PROXY=false
# Set true in production behind HTTPS proxy. Local HTTP dev should keep false.
REQUIRE_HTTPS=false
REQUEST_ID_HEADER=x-request-id
REJECT_PROTOTYPE_POLLUTION=true
HSTS_MAX_AGE_SEC=15552000

# Specific rate limits for sensitive endpoints.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
LINK_DEVICE_RATE_LIMIT_WINDOW_MS=900000
LINK_DEVICE_RATE_LIMIT_MAX=10
FEED_NOW_RATE_LIMIT_WINDOW_MS=60000
FEED_NOW_RATE_LIMIT_MAX=20
CONFIG_GENERATION_RATE_LIMIT_WINDOW_MS=600000
CONFIG_GENERATION_RATE_LIMIT_MAX=15
ADMIN_SENSITIVE_RATE_LIMIT_WINDOW_MS=600000
ADMIN_SENSITIVE_RATE_LIMIT_MAX=30

# Enable a local route for testing 500 JSON error response.
# GET /api/dev/error
ENABLE_DEV_ERROR_ROUTE=false

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pet_feeder_iot
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Dev reset protection. Required for: npm run db:reset -- --force
DB_ALLOW_RESET=false

# Seed admin account
SEED_ADMIN_FULL_NAME=System Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123456

# Seed MQTT server
SEED_MQTT_SERVER_NAME=local-broker
SEED_MQTT_HOST=127.0.0.1
SEED_MQTT_PORT=1883
SEED_MQTT_TLS_PORT=8883
SEED_MQTT_WEBSOCKET_PORT=9001
SEED_MQTT_USE_TLS=false

# Seed demo device. Match these values with ESP8266 firmware while testing.
SEED_DEMO_DEVICE_ID=feeder001
SEED_DEMO_MACHINE_CODE=PF-ESP8266-001
SEED_DEMO_PAIRING_CODE=A8K2-91PQ
SEED_DEMO_DEVICE_SECRET=CHANGE_ME_DEVICE_SECRET
SEED_DEMO_MQTT_USERNAME=feeder001
SEED_DEMO_MQTT_PASSWORD=feeder001_dev_password

# Auth / JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Config file generation
CONFIG_FILE_TTL_SEC=1800
DEFAULT_TIMEZONE=Asia/Bangkok
DEFAULT_TIMEZONE_OFFSET_SEC=25200
DEFAULT_KEEP_SETUP_AP_ENABLED=false
DEFAULT_MQTT_USE_TLS=false
ALLOW_DEMO_KEEP_SETUP_AP=true
PROVIDER_NAME=Phong Dương Hùng
PROVIDER_BRAND=Pet Feeder IoT
PROVIDER_WEBSITE=https://your-domain.com
PROVIDER_CONTACT=your-email@example.com
PROVIDER_NOTE=Thiết bị và file cấu hình được cung cấp bởi Phong Dương Hùng.


# Phase 12/17 workers: command timeout + device stale/offline
# Phase 17 can override COMMAND_* and DEVICE_ONLINE_TTL_SEC from system_settings at runtime.
# Default is false for local development without a running DB. Enable in real server/dev DB testing.
WORKERS_ENABLED=false
WORKERS_RUN_ON_START=true
WORKERS_LOG_NOOP_RUNS=false
COMMAND_TIMEOUT_WORKER_ENABLED=true
COMMAND_TIMEOUT_WORKER_INTERVAL_MS=10000
COMMAND_ACK_TIMEOUT_SEC=30
COMMAND_COMPLETE_TIMEOUT_SEC=60
DEVICE_OFFLINE_WORKER_ENABLED=true
DEVICE_OFFLINE_WORKER_INTERVAL_MS=30000
DEVICE_ONLINE_TTL_SEC=90

# Phase 9/10 MQTT connection + inbound handler service
# Default is false so local development does not keep reconnecting when no broker is running.
MQTT_ENABLED=false
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_BROKER_USE_TLS=false
MQTT_SERVICE_USERNAME=
MQTT_SERVICE_PASSWORD=
MQTT_CLIENT_ID=pet-feeder-server-dev
MQTT_KEEPALIVE_SEC=60
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_SUBSCRIBE_QOS=1
MQTT_PUBLISH_QOS=1
MQTT_TLS_REJECT_UNAUTHORIZED=true
MQTT_ADMIN_TEST_TIMEOUT_MS=5000
MQTT_ADMIN_TEST_CLIENT_ID_PREFIX=pet-feeder-admin-test

# Phase 20 deployment notes
# Use comma-separated production origins, never * in NODE_ENV=production.
# Example: CORS_ORIGIN=https://app.example.com,https://admin.example.com
# Set TRUST_PROXY=true and REQUIRE_HTTPS=true when running behind nginx/Caddy/Cloudflare.
# Keep MQTT_ENABLED=false until a broker is reachable.

# Chatbot AI Configuration
AI_BASE_URL=https://your-ai-api-endpoint/v1
AI_API_KEY=your_api_key_here
AI_MODEL=your_model_name_here

